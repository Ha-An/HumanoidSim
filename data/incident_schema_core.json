{
  "version": "0.1.0",
  "description": "General humanoid incident taxonomy. Incidents are represented as StateReason plus recovery protocol, not as new state enum values.",
  "categories": [
    {
      "id": "perception_identification",
      "name": "Perception & Identification",
      "description": "Target detection, identity, pose, marker, and presence problems."
    },
    {
      "id": "manipulation_payload",
      "name": "Manipulation & Payload",
      "description": "Grip, lift, placement, payload stability, and carried item problems."
    },
    {
      "id": "resource_environment",
      "name": "Resource & Environment",
      "description": "Missing/preempted resources, blocked workspace, contamination, or inaccessible environment."
    },
    {
      "id": "motion_traffic",
      "name": "Motion & Traffic",
      "description": "Navigation, traffic, docking, collision, and route execution problems."
    },
    {
      "id": "power_hardware",
      "name": "Power & Hardware",
      "description": "Battery, power, sensor, actuator, tool, or end-effector problems."
    },
    {
      "id": "system_communication",
      "name": "System & Communication",
      "description": "Network, command, context, map, and record synchronization problems."
    },
    {
      "id": "safety_human_interaction",
      "name": "Safety & Human Interaction",
      "description": "Safety stop, human/robot zone conflict, operator readiness, and handover problems."
    },
    {
      "id": "unknown",
      "name": "Unknown",
      "description": "Unexpected or unclassified interruption with insufficient cause evidence."
    }
  ],
  "incidents": [
    {
      "code": "OBJECT_RECOGNITION_FAILED",
      "category": "perception_identification",
      "severity": "warning",
      "default_availability": "BLOCKED",
      "description": "The humanoid cannot recognize the expected target object.",
      "trigger_primitives": ["LOCALIZE_OBJECT", "PRIMITIVE_IDENTIFY_ITEM", "IDENTIFY_PRODUCT"],
      "recovery_protocol": [
        {"kind": "primitive", "code": "LOCALIZE_OBJECT"},
        {"kind": "primitive", "code": "PRIMITIVE_IDENTIFY_ITEM"},
        {"kind": "task", "code": "IDENTIFY_ITEM"},
        {"kind": "task", "code": "CREATE_EXCEPTION_REPORT", "optional": true}
      ],
      "retry_policy": {"max_local_retries": 1, "retry_delay_min": 0.1}
    },
    {
      "code": "POSE_ESTIMATION_FAILED",
      "category": "perception_identification",
      "severity": "warning",
      "default_availability": "BLOCKED",
      "description": "The target exists but its pose or approach direction cannot be estimated.",
      "trigger_primitives": ["LOCALIZE_OBJECT", "LOCALIZE_COMPONENTS", "LOCALIZE_PART", "LOCALIZE_SURFACE"],
      "recovery_protocol": [
        {"kind": "primitive", "code": "LOCALIZE_OBJECT"},
        {"kind": "primitive", "code": "ALIGN"},
        {"kind": "task", "code": "CREATE_EXCEPTION_REPORT", "optional": true}
      ],
      "retry_policy": {"max_local_retries": 1, "retry_delay_min": 0.1}
    },
    {
      "code": "LABEL_OR_MARKER_UNREADABLE",
      "category": "perception_identification",
      "severity": "warning",
      "default_availability": "BLOCKED",
      "description": "A barcode, QR code, label, marker, OCR text, serial, or lot identifier cannot be read.",
      "trigger_primitives": ["PRIMITIVE_IDENTIFY_ITEM", "IDENTIFY_PRODUCT", "READ_MACHINE_STATE"],
      "recovery_protocol": [
        {"kind": "task", "code": "IDENTIFY_ITEM"},
        {"kind": "task", "code": "CREATE_EXCEPTION_REPORT", "optional": true}
      ],
      "retry_policy": {"max_local_retries": 1, "retry_delay_min": 0.1}
    },
    {
      "code": "TARGET_NOT_FOUND",
      "category": "perception_identification",
      "severity": "warning",
      "default_availability": "BLOCKED",
      "description": "The expected target is not present at the planned location.",
      "trigger_primitives": ["LOCALIZE_OBJECT", "PRIMITIVE_IDENTIFY_ITEM"],
      "recovery_protocol": [
        {"kind": "primitive", "code": "LOCALIZE_OBJECT"},
        {"kind": "task", "code": "IDENTIFY_ITEM"},
        {"kind": "task", "code": "CREATE_EXCEPTION_REPORT", "optional": true}
      ],
      "retry_policy": {"max_local_retries": 0, "retry_delay_min": 0.0}
    },
    {
      "code": "GRIP_FAILED",
      "category": "manipulation_payload",
      "severity": "warning",
      "default_availability": "BLOCKED",
      "description": "The humanoid cannot acquire the item or tool with its gripper.",
      "trigger_primitives": ["GRASP"],
      "recovery_protocol": [
        {"kind": "primitive", "code": "REACH_TO"},
        {"kind": "primitive", "code": "GRASP"},
        {"kind": "primitive", "code": "LIFT"},
        {"kind": "task", "code": "SELF_CHECK", "optional": true},
        {"kind": "task", "code": "RECOVER_FROM_FAULT", "optional": true}
      ],
      "retry_policy": {"max_local_retries": 1, "retry_delay_min": 0.1}
    },
    {
      "code": "LIFT_FAILED",
      "category": "manipulation_payload",
      "severity": "warning",
      "default_availability": "BLOCKED",
      "description": "The humanoid grips the item but cannot lift it safely.",
      "trigger_primitives": ["LIFT"],
      "recovery_protocol": [
        {"kind": "primitive", "code": "GRASP"},
        {"kind": "primitive", "code": "LIFT"},
        {"kind": "task", "code": "HANDOVER_ITEM", "optional": true},
        {"kind": "task", "code": "RECOVER_FROM_FAULT", "optional": true}
      ],
      "retry_policy": {"max_local_retries": 1, "retry_delay_min": 0.1}
    },
    {
      "code": "ITEM_DROPPED",
