<?xml version="1.0"?>
<robot name="humanoidsim_minimal_humanoid">
  <material name="body"><color rgba="0.58 0.70 0.82 1"/></material>
  <material name="head"><color rgba="0.92 0.96 1.00 1"/></material>
  <material name="joint"><color rgba="0.18 0.28 0.40 1"/></material>
  <material name="screen"><color rgba="0.05 0.55 0.85 1"/></material>

  <link name="base_link">
    <inertial>
      <mass value="8"/>
      <origin xyz="0 0 0.25"/>
      <inertia ixx="0.3" ixy="0" ixz="0" iyy="0.3" iyz="0" izz="0.3"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.2"/>
      <geometry><box size="0.34 0.24 0.38"/></geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.2"/>
      <geometry><box size="0.34 0.24 0.38"/></geometry>
    </collision>
  </link>

  <link name="head">
    <visual>
      <origin xyz="0 0 0.14"/>
      <geometry><box size="0.28 0.24 0.28"/></geometry>
      <material name="head"/>
    </visual>
    <visual>
      <origin xyz="0.145 0 0.17"/>
      <geometry><box size="0.012 0.14 0.05"/></geometry>
      <material name="screen"/>
    </visual>
  </link>
  <joint name="neck_joint" type="fixed">
    <parent link="base_link"/>
    <child link="head"/>
    <origin xyz="0 0 0.42"/>
  </joint>

  <link name="left_arm">
    <visual>
      <origin xyz="0 0 -0.17"/>
      <geometry><box size="0.10 0.08 0.34"/></geometry>
      <material name="joint"/>
    </visual>
  </link>
  <joint name="left_arm_joint" type="revolute">
    <parent link="base_link"/>
    <child link="left_arm"/>
    <origin xyz="0 0.19 0.28"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="4" velocity="4"/>
  </joint>

  <link name="right_arm">
    <visual>
      <origin xyz="0 0 -0.17"/>
      <geometry><box size="0.10 0.08 0.34"/></geometry>
      <material name="joint"/>
    </visual>
  </link>
  <joint name="right_arm_joint" type="revolute">
    <parent link="base_link"/>
    <child link="right_arm"/>
    <origin xyz="0 -0.19 0.28"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="4" velocity="4"/>
  </joint>

  <link name="left_leg">
    <visual>
      <origin xyz="0 0 -0.16"/>
      <geometry><box size="0.10 0.08 0.32"/></geometry>
      <material name="joint"/>
    </visual>
  </link>
  <joint name="left_leg_joint" type="revolute">
    <parent link="base_link"/>
    <child link="left_leg"/>
    <origin xyz="0 0.08 0.02"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.8" upper="0.8" effort="4" velocity="4"/>
  </joint>

  <link name="right_leg">
    <visual>
      <origin xyz="0 0 -0.16"/>
      <geometry><box size="0.10 0.08 0.32"/></geometry>
      <material name="joint"/>
    </visual>
  </link>
  <joint name="right_leg_joint" type="revolute">
    <parent link="base_link"/>
    <child link="right_leg"/>
    <origin xyz="0 -0.08 0.02"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.8" upper="0.8" effort="4" velocity="4"/>
  </joint>

  <link name="left_gripper">
    <visual>
      <origin xyz="0 0 -0.08"/>
      <geometry><box size="0.08 0.06 0.16"/></geometry>
      <material name="body"/>
    </visual>
  </link>
  <joint name="left_gripper_joint" type="revolute">
    <parent link="left_arm"/>
    <child link="left_gripper"/>
    <origin xyz="0 0 -0.36"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.6" upper="0.6" effort="2" velocity="4"/>
  </joint>

  <link name="right_gripper">
    <visual>
      <origin xyz="0 0 -0.08"/>
      <geometry><box size="0.08 0.06 0.16"/></geometry>
      <material name="body"/>
    </visual>
  </link>
  <joint name="right_gripper_joint" type="revolute">
    <parent link="right_arm"/>
    <child link="right_gripper"/>
    <origin xyz="0 0 -0.36"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.6" upper="0.6" effort="2" velocity="4"/>
  </joint>
</robot>
